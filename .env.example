# Example .env file for db_connection
# Do not commit secrets into source control.

# Standard PostgreSQL connection URL format:
# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require

DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-round-star-afetxr0p.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require

# If you use a pooler or proxy, point the URL at the pooler host instead:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@pooler-host.example.com:5432/neondb?sslmode=require
